# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Tavily key (free tier): https://app.tavily.com
TAVILY_API_KEY=
# Model in provider:name form
MODEL=google_genai:gemini-3.1-flash-lite
FALLBACK_MODEL=google_genai:gemini-3.5-flash-lite
# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
